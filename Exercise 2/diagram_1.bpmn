    <bpmn:sequenceFlow id="Flow_0a1gnd2" sourceRef="Gateway_0n76pvj" targetRef="Activity_1u09klt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionResult.riskTier = "LOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ukdmrn" sourceRef="Gateway_0n76pvj" targetRef="Activity_0u0jd0m">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionResult.riskTier = "MEDIUM" or decisionResult.requiresManualReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0toc6s3" name="Loan Approved">
      <bpmn:incoming>Flow_1px7cda</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1px7cda" sourceRef="Activity_1u09klt" targetRef="Event_0toc6s3" />
    <bpmn:serviceTask id="Activity_1u09klt" name="Auto-Approve and Disburse">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-reject-worker" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0a1gnd2</bpmn:incoming>
      <bpmn:outgoing>Flow_1px7cda</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_0u0jd0m" name="Underwriter Review">
