    <bpmn:endEvent id="Event_09iusly" name="Review Completed">
      <bpmn:incoming>Flow_03ul2v0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03ul2v0" sourceRef="Activity_0u0jd0m" targetRef="Event_09iusly" />
    <bpmn:sequenceFlow id="Flow_0iorkli" sourceRef="Gateway_0n76pvj" targetRef="Activity_1tpfz53">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionResult.riskTier = "HIGH" and decisionResult.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_04rdvkk" name="Loan Rejected">
