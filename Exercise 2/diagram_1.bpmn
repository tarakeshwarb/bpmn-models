  <bpmn:process id="Process_0bjo6ve" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Loan Application Submitted">
      <bpmn:outgoing>Flow_1t77xay</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1t77xay" sourceRef="StartEvent_1" targetRef="Activity_1ozd3qy" />
    <bpmn:businessRuleTask id="Activity_1ozd3qy" name="Evaluate Loan Risk">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="evaluate-loan-risk" resultVariable="decisionResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1t77xay</bpmn:incoming>
      <bpmn:outgoing>Flow_1ixk5pp</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_0n76pvj">
