<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Logistics" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn2:collaboration id="Collaboration_Logistics">
    <bpmn2:participant id="Participant_Courier" name="Courier Company Logistics" processRef="Process_Logistics" />
  </bpmn2:collaboration>
  <bpmn2:process id="Process_Logistics" name="Logistics and Shipment Exception Management" isExecutable="true">
    <bpmn2:laneSet id="LaneSet_Logistics">
      <bpmn2:lane id="Lane_Shipper" name="Shipper / Customer">
        <bpmn2:flowNodeRef>StartEvent_Booking</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_CorrectBooking</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_PickupCancelled</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Dispatcher" name="Control Tower / Dispatcher">
        <bpmn2:extensionElements>
          <camunda:properties>
            <camunda:property />
          </camunda:properties>
        </bpmn2:extensionElements>
        <bpmn2:flowNodeRef>ParallelGateway_Split</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ServiceTask_NotifyCustomer</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EventBasedGateway_Tracking</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>MessageEvent_ScanReceived</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_PickupCheck</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>BusinessRuleTask_ValidateBooking</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ServiceTask_SchedulePickup</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_ValidBooking</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_ReschedulePickup</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ParallelGateway_Join</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_CloseShipment</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Delivered</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_RerouteShipment</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>TimerEvent_48HrScan</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Lost</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>TimerEvent_5DayTrace</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ServiceTask_InitiateTracing</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EventBasedGateway_Customs</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>MessageEvent_DocsReceived</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_StopShipment</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>TimerEvent_CustomsTimer</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Cancelled</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ServiceTask_CustomsHold</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_PickupAgent" name="Pickup Agent">
        <bpmn2:flowNodeRef>ManualTask_CollectScanParcel</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Warehouse" name="Hub / Warehouse">
        <bpmn2:flowNodeRef>ServiceTask_SortScanParcel</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_HubRouting</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_InspectDamage</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_InsuranceCheck</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ServiceTask_RecordDamage</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_DamageReturned</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_ClaimsDepartment" name="Claims Department">
        <bpmn2:flowNodeRef>EndEvent_ClaimSettled</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SubProcess_Claims</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_DeliveryAgent" name="Delivery Agent">
        <bpmn2:flowNodeRef>ServiceTask_DispatchParcel</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_DeliverParcel</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_RetryDelivery</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_AttemptCheck</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>UserTask_ReturnToSender</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>TimerEvent_DepotHold</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Returned</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Recipient" name="Recipient">
        <bpmn2:flowNodeRef>UserTask_ReceiveParcel</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExclusiveGateway_DeliveryOutcome</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>
    <bpmn2:sequenceFlow id="Flow_Return_End" sourceRef="UserTask_ReturnToSender" targetRef="EndEvent_Returned" />
    <bpmn2:sequenceFlow id="Flow_DepotTimeout" sourceRef="TimerEvent_DepotHold" targetRef="UserTask_ReturnToSender" />
    <bpmn2:sequenceFlow id="Flow_AttemptLimitExceeded" name="Attempts &#62; 3" sourceRef="ExclusiveGateway_AttemptCheck" targetRef="TimerEvent_DepotHold">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">deliveryAttempts &gt; 3</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_8" sourceRef="UserTask_RetryDelivery" targetRef="ExclusiveGateway_AttemptCheck" />
    <bpmn2:sequenceFlow id="Flow_RetryMore" name="Attempts &#60;= 3" sourceRef="ExclusiveGateway_AttemptCheck" targetRef="UserTask_DeliverParcel">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">deliveryAttempts &lt;= 3</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="ServiceTask_DispatchParcel" targetRef="UserTask_DeliverParcel" />
    <bpmn2:sequenceFlow id="Flow_Claims_End" sourceRef="SubProcess_Claims" targetRef="EndEvent_ClaimSettled" />
    <bpmn2:sequenceFlow id="Flow_Damage_End" sourceRef="ServiceTask_RecordDamage" targetRef="EndEvent_DamageReturned" />
    <bpmn2:sequenceFlow id="Flow_NotInsured" name="Not Insured" sourceRef="ExclusiveGateway_InsuranceCheck" targetRef="ServiceTask_RecordDamage">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">isInsured == false</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Insured" name="Insured" sourceRef="ExclusiveGateway_InsuranceCheck" targetRef="SubProcess_Claims">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">isInsured == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Cancel_End" sourceRef="UserTask_StopShipment" targetRef="EndEvent_Cancelled" />
    <bpmn2:sequenceFlow id="Flow_Customs_Timeout" sourceRef="TimerEvent_CustomsTimer" targetRef="UserTask_StopShipment" />
    <bpmn2:sequenceFlow id="Flow_Customs_Cleared" name="Cleared" sourceRef="MessageEvent_DocsReceived" targetRef="ServiceTask_DispatchParcel" />
    <bpmn2:sequenceFlow id="Flow_Customs_Timer" sourceRef="EventBasedGateway_Customs" targetRef="TimerEvent_CustomsTimer" />
    <bpmn2:sequenceFlow id="Flow_Customs_Doc" sourceRef="EventBasedGateway_Customs" targetRef="MessageEvent_DocsReceived" />
    <bpmn2:sequenceFlow id="Flow_Customs_Wait" sourceRef="ServiceTask_CustomsHold" targetRef="EventBasedGateway_Customs" />
    <bpmn2:sequenceFlow id="Flow_RecipientUnavail" name="Recipient Unavailable" sourceRef="ExclusiveGateway_DeliveryOutcome" targetRef="UserTask_RetryDelivery">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">deliveryStatus == "Unavailable"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_RefusedCOD" name="Refusal / Failed COD" sourceRef="ExclusiveGateway_DeliveryOutcome" targetRef="UserTask_ReturnToSender">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">deliveryStatus == "Refused"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_7" sourceRef="UserTask_ReceiveParcel" targetRef="ExclusiveGateway_DeliveryOutcome" />
    <bpmn2:sequenceFlow id="Flow_Deliver_Recipient" sourceRef="UserTask_DeliverParcel" targetRef="UserTask_ReceiveParcel" />
    <bpmn2:sequenceFlow id="Flow_Trace_Wait" sourceRef="ServiceTask_InitiateTracing" targetRef="TimerEvent_5DayTrace" />
    <bpmn2:sequenceFlow id="Flow_Lost_End" sourceRef="TimerEvent_5DayTrace" targetRef="EndEvent_Lost" />
    <bpmn2:sequenceFlow id="Flow_Trace_Trigger" sourceRef="TimerEvent_48HrScan" targetRef="ServiceTask_InitiateTracing" />
    <bpmn2:sequenceFlow id="Flow_Reroute_Done" sourceRef="UserTask_RerouteShipment" targetRef="ServiceTask_DispatchParcel" />
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="UserTask_CloseShipment" targetRef="EndEvent_Delivered" />
    <bpmn2:sequenceFlow id="Flow_9" sourceRef="ParallelGateway_Join" targetRef="UserTask_CloseShipment" />
    <bpmn2:sequenceFlow id="Flow_DeliveredOK" name="Delivered" sourceRef="ExclusiveGateway_DeliveryOutcome" targetRef="ParallelGateway_Join">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">deliveryStatus == "Delivered"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Invalid" name="Invalid" sourceRef="ExclusiveGateway_ValidBooking" targetRef="UserTask_CorrectBooking">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">isValid == false</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_RetryPickup" sourceRef="UserTask_ReschedulePickup" targetRef="ServiceTask_SchedulePickup" />
    <bpmn2:sequenceFlow id="Flow_Valid" name="Valid" sourceRef="ExclusiveGateway_ValidBooking" targetRef="ServiceTask_SchedulePickup">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">isValid == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="BusinessRuleTask_ValidateBooking" targetRef="ExclusiveGateway_ValidBooking" />
    <bpmn2:sequenceFlow id="Flow_Corrected" sourceRef="UserTask_CorrectBooking" targetRef="BusinessRuleTask_ValidateBooking" />
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_Booking" targetRef="BusinessRuleTask_ValidateBooking" />
    <bpmn2:sequenceFlow id="Flow_PickupCancel" name="Failed (&#62;2 tries)" sourceRef="ExclusiveGateway_PickupCheck" targetRef="EndEvent_PickupCancelled">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">pickupSuccess == false and pickupAttempts &gt; 2</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_PickupFailed" name="Failed (&#60;=2 tries)" sourceRef="ExclusiveGateway_PickupCheck" targetRef="UserTask_ReschedulePickup">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">pickupSuccess == false and pickupAttempts &lt;= 2</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_PickupSuccess" name="Success" sourceRef="ExclusiveGateway_PickupCheck" targetRef="ManualTask_CollectScanParcel">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">pickupSuccess == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="ServiceTask_SchedulePickup" targetRef="ExclusiveGateway_PickupCheck" />
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="UserTask_InspectDamage" targetRef="ExclusiveGateway_InsuranceCheck" />
    <bpmn2:sequenceFlow id="Flow_Cancel" name="Cancelled" sourceRef="ExclusiveGateway_HubRouting" targetRef="UserTask_StopShipment">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">hubStatus == "Cancelled"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Customs" name="Customs Hold" sourceRef="ExclusiveGateway_HubRouting" targetRef="ServiceTask_CustomsHold">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">hubStatus == "CustomsHold"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Delay" name="Transit Delay" sourceRef="ExclusiveGateway_HubRouting" targetRef="UserTask_RerouteShipment">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">hubStatus == "Delayed"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Hub_Damage" name="Damaged" sourceRef="ExclusiveGateway_HubRouting" targetRef="UserTask_InspectDamage">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">hubStatus == "Damaged"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Hub_Normal" name="Normal Transit" sourceRef="ExclusiveGateway_HubRouting" targetRef="ServiceTask_DispatchParcel">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">hubStatus == "Normal"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Hub_Missing" name="Missing Parcel" sourceRef="ExclusiveGateway_HubRouting" targetRef="ServiceTask_InitiateTracing">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">hubStatus == "Missing"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Hub_SortDone" sourceRef="ServiceTask_SortScanParcel" targetRef="ExclusiveGateway_HubRouting" />
    <bpmn2:sequenceFlow id="Flow_Track_Complete" sourceRef="MessageEvent_ScanReceived" targetRef="ParallelGateway_Join" />
    <bpmn2:sequenceFlow id="Flow_Track_Timeout" sourceRef="EventBasedGateway_Tracking" targetRef="TimerEvent_48HrScan" />
    <bpmn2:sequenceFlow id="Flow_Track_Normal" sourceRef="EventBasedGateway_Tracking" targetRef="MessageEvent_ScanReceived" />
    <bpmn2:sequenceFlow id="Flow_Track_Wait" sourceRef="ServiceTask_NotifyCustomer" targetRef="EventBasedGateway_Tracking" />
    <bpmn2:sequenceFlow id="Flow_Track_Start" sourceRef="ParallelGateway_Split" targetRef="ServiceTask_NotifyCustomer" />
    <bpmn2:sequenceFlow id="Flow_Move_Hub" sourceRef="ParallelGateway_Split" targetRef="ServiceTask_SortScanParcel" />
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="ManualTask_CollectScanParcel" targetRef="ParallelGateway_Split" />
    <bpmn2:subProcess id="SubProcess_Claims" name="Claims Processing Subprocess">
      <bpmn2:incoming>Flow_Insured</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Claims_End</bpmn2:outgoing>
      <bpmn2:startEvent id="StartEvent_Claims" name="Claims Initiated">
        <bpmn2:outgoing>Flow_C1</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:userTask id="UserTask_ProcessClaim" name="Process refund, replacement, or reshipment">
        <bpmn2:incoming>Flow_C1</bpmn2:incoming>
        <bpmn2:outgoing>Flow_C2</bpmn2:outgoing>
      </bpmn2:userTask>
      <bpmn2:endEvent id="EndEvent_Claims" name="Claims Resolved">
        <bpmn2:incoming>Flow_C2</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Claims" targetRef="UserTask_ProcessClaim" />
      <bpmn2:sequenceFlow id="Flow_C2" sourceRef="UserTask_ProcessClaim" targetRef="EndEvent_Claims" />
    </bpmn2:subProcess>
    <bpmn2:endEvent id="EndEvent_Returned" name="Returned to Sender">
      <bpmn2:incoming>Flow_Return_End</bpmn2:incoming>
      <bpmn2:terminateEventDefinition id="TerminateEventDefinition_Returned" />
    </bpmn2:endEvent>
    <bpmn2:intermediateCatchEvent id="TimerEvent_DepotHold" name="Hold at depot for 7 days">
      <bpmn2:incoming>Flow_AttemptLimitExceeded</bpmn2:incoming>
      <bpmn2:outgoing>Flow_DepotTimeout</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="TimerEventDefinition_DepotHold">
        <bpmn2:timeDuration>P7D</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:userTask id="UserTask_ReturnToSender" name="Return parcel to sender and adjust charges">
      <bpmn2:incoming>Flow_RefusedCOD</bpmn2:incoming>
      <bpmn2:incoming>Flow_DepotTimeout</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Return_End</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_AttemptCheck" name="Attempt Limit Reached?" default="Flow_RetryMore">
      <bpmn2:incoming>Flow_8</bpmn2:incoming>
      <bpmn2:outgoing>Flow_RetryMore</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_AttemptLimitExceeded</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="UserTask_RetryDelivery" name="Retry delivery (Max 3 attempts)">
      <bpmn2:incoming>Flow_RecipientUnavail</bpmn2:incoming>
      <bpmn2:outgoing>Flow_8</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="UserTask_DeliverParcel" name="Deliver parcel to recipient">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
      <bpmn2:incoming>Flow_RetryMore</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Deliver_Recipient</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:serviceTask id="ServiceTask_DispatchParcel" name="Dispatch parcel for delivery and notify recipient">
      <bpmn2:incoming>Flow_Hub_Normal</bpmn2:incoming>
      <bpmn2:incoming>Flow_Reroute_Done</bpmn2:incoming>
      <bpmn2:incoming>Flow_Customs_Cleared</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="ServiceTask_CustomsHold" name="Request missing documents for customs">
      <bpmn2:incoming>Flow_Customs</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Customs_Wait</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:endEvent id="EndEvent_ClaimSettled" name="Claims Resolved &#38; Settled">
      <bpmn2:incoming>Flow_Claims_End</bpmn2:incoming>
      <bpmn2:terminateEventDefinition id="TerminateEventDefinition_ClaimSettled" />
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_DamageReturned" name="Returned to Sender">
      <bpmn2:incoming>Flow_Damage_End</bpmn2:incoming>
      <bpmn2:terminateEventDefinition id="TerminateEventDefinition_DamageReturned" />
    </bpmn2:endEvent>
    <bpmn2:serviceTask id="ServiceTask_RecordDamage" name="Record damage and inform shipper">
      <bpmn2:incoming>Flow_NotInsured</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Damage_End</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_InsuranceCheck" name="Is Parcel Insured?" default="Flow_NotInsured">
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Insured</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_NotInsured</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="EndEvent_Cancelled" name="Shipment Cancelled">
      <bpmn2:incoming>Flow_Cancel_End</bpmn2:incoming>
      <bpmn2:terminateEventDefinition id="TerminateEventDefinition_Cancelled" />
    </bpmn2:endEvent>
    <bpmn2:intermediateCatchEvent id="TimerEvent_CustomsTimer" name="5-Day Customs Timeout">
      <bpmn2:incoming>Flow_Customs_Timer</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Customs_Timeout</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="TimerEventDefinition_Customs">
        <bpmn2:timeDuration>P5D</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:userTask id="UserTask_StopShipment" name="Stop shipment and return parcel">
      <bpmn2:incoming>Flow_Cancel</bpmn2:incoming>
      <bpmn2:incoming>Flow_Customs_Timeout</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Cancel_End</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:intermediateCatchEvent id="MessageEvent_DocsReceived" name="Documents Received">
      <bpmn2:incoming>Flow_Customs_Doc</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Customs_Cleared</bpmn2:outgoing>
      <bpmn2:messageEventDefinition id="MessageEventDefinition_DocsReceived" />
    </bpmn2:intermediateCatchEvent>
    <bpmn2:eventBasedGateway id="EventBasedGateway_Customs" name="Wait for Documents or Timeout">
      <bpmn2:incoming>Flow_Customs_Wait</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Customs_Doc</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Customs_Timer</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>
    <bpmn2:endEvent id="EndEvent_PickupCancelled" name="Booking Cancelled">
      <bpmn2:incoming>Flow_PickupCancel</bpmn2:incoming>
      <bpmn2:terminateEventDefinition id="TerminateEventDefinition_PickupCancelled" />
    </bpmn2:endEvent>
    <bpmn2:serviceTask id="ServiceTask_InitiateTracing" name="Initiate parcel tracing">
      <bpmn2:incoming>Flow_Trace_Trigger</bpmn2:incoming>
      <bpmn2:incoming>Flow_Hub_Missing</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Trace_Wait</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:intermediateCatchEvent id="TimerEvent_5DayTrace" name="5 Days Not Found">
      <bpmn2:incoming>Flow_Trace_Wait</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Lost_End</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="TimerEventDefinition_5DayTrace">
        <bpmn2:timeDuration>P5D</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:endEvent id="EndEvent_Lost" name="Shipment Lost">
      <bpmn2:incoming>Flow_Lost_End</bpmn2:incoming>
      <bpmn2:terminateEventDefinition id="TerminateEventDefinition_Lost" />
    </bpmn2:endEvent>
    <bpmn2:intermediateCatchEvent id="TimerEvent_48HrScan" name="48 Hours No Scan">
      <bpmn2:incoming>Flow_Track_Timeout</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Trace_Trigger</bpmn2:outgoing>
      <bpmn2:timerEventDefinition id="TimerEventDefinition_48Hr">
        <bpmn2:timeDuration>PT48H</bpmn2:timeDuration>
      </bpmn2:timerEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:userTask id="UserTask_RerouteShipment" name="Reroute or assign alternative vehicle">
      <bpmn2:incoming>Flow_Delay</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Reroute_Done</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:endEvent id="EndEvent_Delivered" name="Shipment Delivered">
      <bpmn2:incoming>Flow_10</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:userTask id="UserTask_CloseShipment" name="Close shipment and generate invoice">
      <bpmn2:incoming>Flow_9</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:parallelGateway id="ParallelGateway_Join" name="Join Movement and Tracking">
      <bpmn2:incoming>Flow_DeliveredOK</bpmn2:incoming>
      <bpmn2:incoming>Flow_Track_Complete</bpmn2:incoming>
      <bpmn2:outgoing>Flow_9</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:manualTask id="ManualTask_CollectScanParcel" name="Collect and scan parcel">
      <bpmn2:incoming>Flow_PickupSuccess</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:manualTask>
    <bpmn2:userTask id="UserTask_CorrectBooking" name="Return booking for correction">
      <bpmn2:incoming>Flow_Invalid</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Corrected</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:startEvent id="StartEvent_Booking" name="Shipper books shipment">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="UserTask_ReschedulePickup" name="Reschedule pickup (Max 2 attempts)">
      <bpmn2:incoming>Flow_PickupFailed</bpmn2:incoming>
      <bpmn2:outgoing>Flow_RetryPickup</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_ValidBooking" name="Booking Valid?" default="Flow_Valid">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Valid</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Invalid</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:serviceTask id="ServiceTask_SchedulePickup" name="Schedule pickup and assign agent">
      <bpmn2:incoming>Flow_Valid</bpmn2:incoming>
      <bpmn2:incoming>Flow_RetryPickup</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:businessRuleTask id="BusinessRuleTask_ValidateBooking" name="Validate address and charges" camunda:resultVariable="tariffResult" camunda:decisionRef="calculate-shipping-charges">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:incoming>Flow_Corrected</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:businessRuleTask>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_PickupCheck" name="Pickup Successful?" default="Flow_PickupSuccess">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_PickupSuccess</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_PickupFailed</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_PickupCancel</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="UserTask_InspectDamage" name="Inspect damaged parcel">
      <bpmn2:incoming>Flow_Hub_Damage</bpmn2:incoming>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_HubRouting" name="Hub Sorting Outcome?" default="Flow_Hub_Normal">
      <bpmn2:incoming>Flow_Hub_SortDone</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Hub_Normal</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Hub_Damage</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Delay</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Customs</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Hub_Missing</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Cancel</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:serviceTask id="ServiceTask_SortScanParcel" name="Sort and scan parcel at hub">
      <bpmn2:incoming>Flow_Move_Hub</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Hub_SortDone</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:intermediateCatchEvent id="MessageEvent_ScanReceived" name="Scan / Delivery Update Received">
      <bpmn2:incoming>Flow_Track_Normal</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Track_Complete</bpmn2:outgoing>
      <bpmn2:messageEventDefinition id="MessageEventDefinition_ScanReceived" />
    </bpmn2:intermediateCatchEvent>
    <bpmn2:eventBasedGateway id="EventBasedGateway_Tracking" name="Wait for Scan or 48-Hr Timeout">
      <bpmn2:incoming>Flow_Track_Wait</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Track_Normal</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Track_Timeout</bpmn2:outgoing>
    </bpmn2:eventBasedGateway>
    <bpmn2:serviceTask id="ServiceTask_NotifyCustomer" name="Notify customer of tracking updates">
      <bpmn2:incoming>Flow_Track_Start</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Track_Wait</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:parallelGateway id="ParallelGateway_Split" name="Split Movement and Tracking">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Move_Hub</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Track_Start</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:userTask id="UserTask_ReceiveParcel" name="Receive parcel and provide proof of delivery">
      <bpmn2:incoming>Flow_Deliver_Recipient</bpmn2:incoming>
      <bpmn2:outgoing>Flow_7</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_DeliveryOutcome" name="Delivery Outcome?" default="Flow_DeliveredOK">
      <bpmn2:incoming>Flow_7</bpmn2:incoming>
      <bpmn2:outgoing>Flow_DeliveredOK</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_RecipientUnavail</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_RefusedCOD</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
  </bpmn2:process>
